          }
        },
        "required": [
          "items"
        ],
        "title": "Page[MemberRead]",
        "type": "object"
      },
      "Page_OrganizationRead_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrganizationRead"
            },
            "title": "Items",
