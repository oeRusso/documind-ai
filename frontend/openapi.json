            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InvitationAccept": {
        "description": "The two values in the invitation link, after `#`.",
        "properties": {
          "organization_id": {
            "format": "uuid",
            "title": "Organization Id",
            "type": "string"
          },
          "token": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "organization_id",
          "token"
        ],
        "title": "InvitationAccept",
        "type": "object"
      },
      "InvitationCreate": {
        "properties": {
          "email": {
            "examples": [
              "carla@acme.com"
