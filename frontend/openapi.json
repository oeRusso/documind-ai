      },
      "RegisterRequest": {
        "description": "Either `organization_name` + `organization_slug` (new organization) or `invitation`.",
        "properties": {
          "email": {
            "examples": [
              "ana@acme.com"
            ],
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "invitation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InvitationAccept"
              },
              {
                "type": "null"
              }
            ]
          },
          "organization_name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "Acme S.A."
            ],
            "title": "Organization Name"
          },
          "organization_slug": {
            "anyOf": [
              {
                "maxLength": 63,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "acme"
            ],
            "title": "Organization Slug"
          },
          "password": {
            "examples": [
              "una frase larga y fácil de recordar"
            ],
            "maxLength": 128,
            "title": "Password",
            "type": "string"
          },
          "website": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Dejar vacío",
            "title": "Website"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "Role": {
        "enum": [
          "owner",
          "admin",
          "member",
          "viewer"
        ],
        "title": "Role",
        "type": "string"
      },
      "TokenResponse": {
        "description": "The refresh token is NOT here: it travels in an HttpOnly cookie.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_at"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "UserRead": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
