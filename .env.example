# DocuMind AI — variables de entorno de ejemplo.
# Copiá este archivo a .env y reemplazá los valores. Nunca commitees .env.
# En el VPS, .env va con permisos 600. Cada bloque indica la etapa en la que entra.

# --- Etapa 1: backend y base de datos ---
APP_ENV=development
# Opcionales: LOG_LEVEL (DEBUG|INFO|WARNING|ERROR) y LOG_FORMAT (json|console).
LOG_LEVEL=INFO
LOG_FORMAT=console

# Contraseñas que usa compose.yaml para crear los roles de PostgreSQL (primer arranque).
# Generalas con `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-app
MIGRATOR_DB_PASSWORD=change-me-migrator

# URLs para correr el backend FUERA de los contenedores (uv run, pytest) contra 127.0.0.1.
# Dentro de compose, la API usa el host `db` y arma estas URLs con las contraseñas de arriba.
# Las contraseñas tienen que coincidir con APP_DB_PASSWORD y MIGRATOR_DB_PASSWORD.
DATABASE_URL=postgresql+asyncpg://app:change-me-app@localhost:5432/documind
# Rol con permisos de migración (dueño de las tablas). La app usa un rol que no puede saltarse RLS.
DATABASE_MIGRATION_URL=postgresql+asyncpg://migrator:change-me-migrator@localhost:5432/documind

# --- Etapa 2: autenticación ---
# Obligatoria, mínimo 32 caracteres. Generala con `openssl rand -hex 32` (da 64).
# La app no arranca con este valor de ejemplo.
JWT_SECRET=change-me-64-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Origen del frontend (sin barra final). Los endpoints con cookie rechazan cualquier otro (CSRF).
APP_ORIGIN=http://localhost:3000

# --- Etapa 4: documentos ---
STORAGE_PATH=/data/documents
MAX_UPLOAD_MB=25

# --- Etapa 5: colas (Valkey usa el protocolo de Redis) ---
CELERY_BROKER_URL=redis://valkey:6379/0

# --- Etapa 6: embeddings ---
OLLAMA_URL=http://ollama:11434
# Se define en la etapa 6.
EMBEDDING_MODEL=

# --- Etapa 7: generación ---
# Se define en la etapa 7.
LLM_MODEL=
# Umbral calibrado con el dataset de evaluación.
RAG_MIN_SCORE=
LLM_MAX_CONCURRENCY=1
