# DocuMind AI — variables de entorno de ejemplo.
# Copiá este archivo a .env y reemplazá los valores. Nunca commitees .env.
# En el VPS, .env va con permisos 600. Cada bloque indica la etapa en la que entra.

# --- Etapa 1: backend y base de datos ---
APP_ENV=development
# Opcionales: LOG_LEVEL (DEBUG|INFO|WARNING|ERROR) y LOG_FORMAT (json|console).
LOG_LEVEL=INFO
LOG_FORMAT=console

# Contraseñas que usa compose.yaml para crear los roles de PostgreSQL (primer arranque).
# Generalas con `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-app
MIGRATOR_DB_PASSWORD=change-me-migrator

# URLs para correr el backend FUERA de los contenedores (uv run, pytest) contra 127.0.0.1.
# Dentro de compose, la API usa el host `db` y arma estas URLs con las contraseñas de arriba.
# Las contraseñas tienen que coincidir con APP_DB_PASSWORD y MIGRATOR_DB_PASSWORD.
DATABASE_URL=postgresql+asyncpg://app:change-me-app@localhost:5432/documind
# Rol con permisos de migración (dueño de las tablas). La app usa un rol que no puede saltarse RLS.
DATABASE_MIGRATION_URL=postgresql+asyncpg://migrator:change-me-migrator@localhost:5432/documind

# --- Etapa 2: autenticación ---
# Obligatoria, mínimo 32 caracteres. Generala con `openssl rand -hex 32` (da 64).
# La app no arranca con este valor de ejemplo.
JWT_SECRET=change-me-64-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Origen del frontend (sin barra final). Los endpoints con cookie rechazan cualquier otro (CSRF).
APP_ORIGIN=http://localhost:3000

# Límites de intentos (ADR 0005). Por IP y, en el login, también por email.
LOGIN_LIMIT_PER_IP_PER_MINUTE=20
LOGIN_LIMIT_PER_EMAIL_PER_15_MINUTES=10
REGISTER_LIMIT_PER_IP_PER_HOUR=10
ACCEPT_INVITATION_LIMIT_PER_USER_PER_MINUTE=10

# Email (invitaciones). En desarrollo, compose.yaml usa Mailpit (http://127.0.0.1:8025).
# Sin SMTP_HOST no se manda nada (solo se registra en el log): el link de invitación igual
# se le muestra a quien invita. En producción, sumar un servidor SMTP es un servicio externo:
# preguntar antes (CLAUDE.md, Restricciones).
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=DocuMind AI <no-reply@documind.local>

# --- Etapa 4: documentos ---
STORAGE_PATH=/data/documents
MAX_UPLOAD_MB=25

# --- Etapa 5: colas (Valkey usa el protocolo de Redis) ---
# Valkey (stage 5). "valkey" only exists inside compose: running the API on the host, leave it
# empty (documents then stay pending) or point it to a Valkey you started yourself.
CELERY_BROKER_URL=redis://valkey:6379/0

# --- Local AI with Ollama (stage 6) ---
# Inside compose: http://ollama:11434 (set in compose.yaml). Empty = no embeddings, words-only search.
OLLAMA_URL=
# bge-m3 (best on the evaluation, ADR 0008) or paraphrase-multilingual (lighter).
EMBEDDING_MODEL=bge-m3

# --- Answers with citations (stage 7, ADR 0009) ---
# Small quantized model (1-3B): the VPS RAM is shared. Pull it: podman compose exec ollama ollama pull <model>
LLM_MODEL=llama3.2:3b
LLM_KEEP_ALIVE=30m
# Answers generated at the same time; the rest wait in line.
LLM_MAX_CONCURRENCY=1
# Best chunk below this meaning similarity: "no encontré evidencia" without calling the LLM.
RAG_MIN_SCORE=0.5
RAG_CONTEXT_TOKENS=1500
RAG_MAX_ANSWER_TOKENS=512
CHAT_LIMIT_PER_USER_PER_MINUTE=10

# --- Documents (stage 4) ---
# Inside the containers the files live in the `documents` volume (STORAGE_PATH is set in compose).
# Running the API on the host instead? Point STORAGE_PATH to a writable folder.
MAX_UPLOAD_MB=25
MAX_UPLOAD_PAGES=500
# Deleted documents keep their files this many days (so restoring a recent backup works).
DOCUMENT_PURGE_DAYS=30
